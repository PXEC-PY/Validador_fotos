rules_version = '2';

// Pegar este contenido en Firebase Console > Firestore Database > Reglas.
// No hay Firebase CLI en esta máquina — ver README.md para los pasos manuales.
//
// Principio (OWASP A01/A04): denegar todo por defecto y validar el ESQUEMA
// completo de cada escritura del lado del servidor. El cliente es anónimo y
// no confiable: cualquier campo que no esté acá explícitamente se rechaza.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optString(data, key, maxLen) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function validUbicacion(u) {
      return u is map
        && u.keys().hasOnly(['lat', 'lng', 'accuracy', 'capturedAt'])
        && u.lat is number && u.lat >= -90 && u.lat <= 90
        && u.lng is number && u.lng >= -180 && u.lng <= 180
        && u.accuracy is number && u.accuracy >= 0 && u.accuracy < 100000
        && u.capturedAt is number;
    }

    // Un doc por admin, ID = uid de Firebase Auth. Se crean a mano desde la
    // consola, nunca desde el cliente.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /lotes/{loteId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'ticketCode', 'agente', 'patente', 'ubicacion', 'status',
             'fotoCount', 'createdAt', 'creatorUid', 'userAgent'])
        && request.resource.data.keys().hasAll([
             'ticketCode', 'agente', 'ubicacion', 'status', 'fotoCount',
             'createdAt', 'creatorUid'])
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.ticketCode is string
        && request.resource.data.ticketCode.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.agente is string
        && request.resource.data.agente.size() >= 2
        && request.resource.data.agente.size() <= 80
        && (request.resource.data.get('patente', null) == null
            || (request.resource.data.patente is string
                && request.resource.data.patente.matches('^[A-Z0-9 -]{1,12}$')))
        && optString(request.resource.data, 'userAgent', 400)
        && request.resource.data.fotoCount is int
        && request.resource.data.fotoCount >= 1
        && request.resource.data.fotoCount <= 20
        && validUbicacion(request.resource.data.ubicacion);

      // Solo el dueño del lote o un admin pueden leerlo.
      allow read: if signedIn()
        && (resource.data.creatorUid == request.auth.uid || isAdmin());

      // Solo un admin revisa, y solo puede tocar los campos de revisión.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'adminNota', 'revisadoPor', 'revisadoAt'])
        && request.resource.data.status in ['pendiente', 'aprobado', 'rechazado']
        && request.resource.data.revisadoPor == request.auth.uid
        && request.resource.data.revisadoAt == request.time
        && optString(request.resource.data, 'adminNota', 1000);

      allow delete: if false;

      match /fotos/{fotoId} {
        function lote() {
          return get(/databases/$(database)/documents/lotes/$(loteId)).data;
        }

        // El dueño agrega fotos solo mientras el lote está pendiente y
        // dentro de las 2 h de creado. Las URLs solo pueden apuntar a NUESTRA
        // cuenta de Cloudinary (evita links a sitios de terceros / phishing).
        allow create: if signedIn()
          && fotoId.matches('^[0-9]{2}$')
          && lote().creatorUid == request.auth.uid
          && lote().status == 'pendiente'
          && request.time < lote().createdAt + duration.value(2, 'h')
          && request.resource.data.keys().hasOnly([
               'url', 'publicId', 'capturedAt', 'order', 'width', 'height', 'bytes', 'fuente'])
          && request.resource.data.keys().hasAll(['url', 'capturedAt', 'order'])
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 500
          && request.resource.data.url.matches('^https://res[.]cloudinary[.]com/vikwio2u/image/upload/[A-Za-z0-9_./-]+$')
          && request.resource.data.order is int
          && request.resource.data.order == int(fotoId)
          && request.resource.data.capturedAt is number
          && optString(request.resource.data, 'publicId', 200)
          && optString(request.resource.data, 'fuente', 20)
          && (!('width' in request.resource.data) || request.resource.data.width is int)
          && (!('height' in request.resource.data) || request.resource.data.height is int)
          && (!('bytes' in request.resource.data) || request.resource.data.bytes is int);

        allow read: if signedIn()
          && (lote().creatorUid == request.auth.uid || isAdmin());

        allow update, delete: if false;
      }
    }
  }
}
